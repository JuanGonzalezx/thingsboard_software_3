# Opcional: Variables de entorno para Telegram
# Puedes configurar estas variables si quieres pre-configurar el bot

# Token del bot (obtenerlo de @BotFather)
TB_TELEGRAM_BOT_TOKEN=tu_token_aqui

# Configuraciones opcionales
TB_TELEGRAM_ENABLED=true
TB_TELEGRAM_TIMEOUT=30000
TB_TELEGRAM_MAX_MESSAGE_LENGTH=4096
